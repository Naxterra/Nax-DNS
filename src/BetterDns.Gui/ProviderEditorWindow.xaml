<Window x:Class="BetterDns.Gui.ProviderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Provider.Title}" Width="650" Height="690" MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="24" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{DynamicResource Provider.Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Provider.Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,18" />
                <TextBlock Text="{DynamicResource Provider.Preset}" Margin="0,0,0,5" />
                <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" />
                <TextBlock Text="{DynamicResource Column.Name}" Margin="0,14,0,5" />
                <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{DynamicResource Column.Protocol}" Margin="0,12,0,5" />
                <ComboBox ItemsSource="{Binding ProtocolOptions}" ItemTemplate="{StaticResource DisplayNamedItemTemplate}" SelectedValuePath="Code" SelectedValue="{Binding Editor.Protocol}" />
                <TextBlock Text="{DynamicResource Provider.Endpoint}" Margin="0,12,0,5" />
                <TextBox Text="{Binding Editor.Endpoint, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{DynamicResource Provider.ProfileHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="{DynamicResource Provider.UseAs}" Margin="0,14,0,5" />
                <ComboBox ItemsSource="{Binding Uses}" ItemTemplate="{StaticResource DisplayNamedItemTemplate}" SelectedValuePath="Code" SelectedValue="{Binding UseAs}" />
                <TextBlock Text="{Binding Editor.BootstrapStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <Expander Header="{DynamicResource Provider.ConnectionSettings}" Margin="0,12,0,0" Foreground="{StaticResource TextPrimary}">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Column.Bootstrap}" />
                        <TextBox Text="{Binding Editor.BootstrapAddresses, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
                        <TextBlock Text="{DynamicResource Provider.BootstrapHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,8" />
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Column.Timeout}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding Editor.TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <CheckBox Content="{DynamicResource Provider.Enabled}" IsChecked="{Binding Editor.Enabled}" Margin="20,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Action.Cancel}" IsCancel="True" />
                <Button Content="{DynamicResource Provider.Accept}" Click="OnAccept" IsDefault="True" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
