<Window x:Class="BetterDns.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Icon="Assets/BetterDNS.ico"
        Height="820" Width="1260" MinHeight="680" MinWidth="980"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBackground}" Margin="0">
      <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeroBackground}"
                BorderBrush="#35445E" BorderThickness="1" CornerRadius="15" Padding="20,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="58" Height="58" Source="Assets/BetterDNS.png" Stretch="Uniform" />

                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Better" FontSize="29" FontWeight="Bold" />
                        <TextBlock Text="DNS" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentTeal}" />
                        <Border Background="#352C58" BorderBrush="{StaticResource AccentPurple}" BorderThickness="1"
                                CornerRadius="9" Padding="7,2" Margin="11,6,0,5">
                            <TextBlock Text=".NET 11" Foreground="#C9B9FF" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource App.Subtitle}" Style="{StaticResource MutedText}" FontSize="13.5" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,17,0">
                        <TextBlock Text="{DynamicResource App.Language}" Style="{StaticResource MutedText}" FontSize="11" Margin="1,0,0,3" />
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                  Width="125">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Border Background="#121A29" BorderBrush="#36455F" BorderThickness="1" CornerRadius="13" Padding="13,9">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#FF6F91" BlurRadius="9" ShadowDepth="0" Opacity="0.55" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentTeal}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#43E6C3" BlurRadius="10" ShadowDepth="0" Opacity="0.65" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="{DynamicResource Tab.Dashboard}">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Background="{StaticResource HeroBackground}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource AccentGradient}" CornerRadius="11,0,0,11" />
                            <StackPanel Grid.Column="1" Margin="22,19">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Dashboard.ProtectionTitle}" FontSize="20" FontWeight="SemiBold" />
                                    <Border Background="#183B39" BorderBrush="#2A6D61" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="10,2,0,1">
                                        <TextBlock Text="KERNEL" Foreground="{StaticResource AccentTeal}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding EnforcementText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding ToggleButtonText}"
                                    Command="{Binding ToggleProtectionCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="175" Margin="20,0,22,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,11">
                                    <Border Width="5" Height="22" CornerRadius="3" Background="{StaticResource AccentPurple}" Margin="0,0,9,0" />
                                    <TextBlock Text="{DynamicResource Dashboard.ResolverHealth}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding UpstreamStatuses}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Column.Resolver}" Binding="{Binding Name}" Width="*" />
                                        <DataGridCheckBoxColumn Header="{DynamicResource Column.Ready}" Binding="{Binding Available}" Width="62" />
                                        <DataGridTextColumn Header="{DynamicResource Column.Latency}" Binding="{Binding LatencyText}" Width="82" />
                                        <DataGridTextColumn Header="{DynamicResource Column.LastError}" Binding="{Binding LastError}" Width="1.1*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,11">
                                    <Border Width="5" Height="22" CornerRadius="3" Background="{StaticResource AccentOrange}" Margin="0,0,9,0" />
                                    <TextBlock Text="{DynamicResource Dashboard.RecentQueries}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Queries}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Column.Time}" Binding="{Binding TimeText}" Width="75" />
                                        <DataGridTextColumn Header="{DynamicResource Column.Domain}" Binding="{Binding Domain}" Width="*" />
                                        <DataGridTextColumn Header="{DynamicResource Column.Resolver}" Binding="{Binding UpstreamName}" Width="1.1*" />
                                        <DataGridTextColumn Header="{DynamicResource Column.Result}" Binding="{Binding Result}" Width="92" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Servers}">
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Action.AddServer}" Command="{Binding AddUpstreamCommand}" Style="{StaticResource PurpleButton}" />
                                <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveUpstreamCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Servers.BootstrapHint}" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Upstreams}" SelectedItem="{Binding SelectedUpstream}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource Column.On}" Binding="{Binding Enabled}" Width="47" />
                                <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                                <DataGridTemplateColumn Header="{DynamicResource Column.Protocol}" Width="95">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Protocol}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox SelectedItem="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.Protocols, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Column.Endpoint}" Binding="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="{DynamicResource Column.Bootstrap}" Binding="{Binding BootstrapAddresses, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" />
                                <DataGridTextColumn Header="{DynamicResource Column.Timeout}" Binding="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Failover}">
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Action.AddChain}" Command="{Binding AddChainCommand}" Style="{StaticResource PurpleButton}" />
                                <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveChainCommand}" />
                                <TextBlock Text="{DynamicResource Failover.DefaultChain}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="18,0,8,0" />
                                <TextBox Text="{Binding DefaultChainId, UpdateSourceTrigger=PropertyChanged}" Width="205" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Failover.Hint}" Style="{StaticResource MutedText}" Margin="0,11,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Column.Id}" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="165" />
                                <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                                <DataGridTextColumn Header="{DynamicResource Column.ResolverOrder}" Binding="{Binding UpstreamIds, UpdateSourceTrigger=PropertyChanged}" Width="2.2*" />
                                <DataGridTextColumn Header="{DynamicResource Column.Failures}" Binding="{Binding FailureThreshold, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                                <DataGridTextColumn Header="{DynamicResource Column.Cooldown}" Binding="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Rules}">
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Action.AddRule}" Command="{Binding AddRuleCommand}" Style="{StaticResource PurpleButton}" />
                                <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveRuleCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Rules.Hint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource Column.On}" Binding="{Binding Enabled}" Width="47" />
                                <DataGridTextColumn Header="{DynamicResource Column.Name}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                                <DataGridTextColumn Header="{DynamicResource Column.Pattern}" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" />
                                <DataGridTemplateColumn Header="{DynamicResource Column.Match}" Width="105">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MatchKind}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox SelectedItem="{Binding MatchKind}" ItemsSource="{Binding DataContext.MatchKinds, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Column.Action}" Width="95">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Action}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox SelectedItem="{Binding Action}" ItemsSource="{Binding DataContext.RuleActions, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Column.Chain}" Binding="{Binding ChainId, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Protection}">
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PurpleGradient}" CornerRadius="11,0,0,11" />
                        <StackPanel Grid.Column="1" Margin="25">
                            <TextBlock Text="{DynamicResource Protection.Title}" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Protection.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,23" MaxWidth="930" HorizontalAlignment="Left" />
                            <CheckBox Content="{DynamicResource Protection.EnableEnforcement}" IsChecked="{Binding EnforcementEnabled}" Margin="0,0,0,14" />
                            <CheckBox Content="{DynamicResource Protection.BlockTcp}" IsChecked="{Binding BlockPlaintextDns}" Margin="0,0,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Protection.Interval}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,11,0" />
                                <TextBox Text="{Binding WatchdogSeconds}" Width="75" />
                            </StackPanel>
                            <Border Background="#121A2A" BorderBrush="#3A365F" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,25,0,0">
                                <TextBlock Text="{DynamicResource Protection.Limit}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="940" HorizontalAlignment="Left" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="2,16,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource AccentCyan}" Margin="0,0,9,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}" />
                <Button Content="{DynamicResource Action.Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0" />
            </StackPanel>
        </Grid>
      </Grid>
    </Grid>
</Window>
