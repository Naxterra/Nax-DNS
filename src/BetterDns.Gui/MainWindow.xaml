<Window x:Class="BetterDns.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterDNS" Height="780" Width="1180" MinHeight="650" MinWidth="940"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BetterDNS" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Encrypted DNS policy and leak protection for Windows" Foreground="{StaticResource TextMuted}" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,9,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Danger}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Dashboard">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="22" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DNS protection" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProtectionText}" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding EnforcementText}" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding ToggleButtonText}" Command="{Binding ToggleProtectionCommand}" MinWidth="150" Margin="20,0,0,0" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Resolver health" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9" />
                            <DataGrid ItemsSource="{Binding UpstreamStatuses}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Resolver" Binding="{Binding Name}" Width="*" />
                                    <DataGridCheckBoxColumn Header="Ready" Binding="{Binding Available}" Width="60" />
                                    <DataGridTextColumn Header="Latency" Binding="{Binding LatencyText}" Width="80" />
                                    <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Recent queries" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9" />
                            <DataGrid ItemsSource="{Binding Queries}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="72" />
                                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
                                    <DataGridTextColumn Header="Resolver" Binding="{Binding UpstreamName}" Width="1.1*" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="DNS servers">
                <DockPanel Margin="0,18,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add server" Command="{Binding AddUpstreamCommand}" />
                        <Button Content="Remove selected" Command="{Binding RemoveUpstreamCommand}" />
                        <TextBlock Text="Bootstrap IPs prevent recursive interception while an encrypted endpoint connects." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Upstreams}" SelectedItem="{Binding SelectedUpstream}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                            <DataGridTemplateColumn Header="Protocol" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Protocol}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.Protocols, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Bootstrap IPs (comma separated)" Binding="{Binding BootstrapAddresses, UpdateSourceTrigger=PropertyChanged}" Width="1.7*" />
                            <DataGridTextColumn Header="Timeout ms" Binding="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Failover">
                <DockPanel Margin="0,18,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add chain" Command="{Binding AddChainCommand}" />
                            <Button Content="Remove selected" Command="{Binding RemoveChainCommand}" />
                            <TextBlock Text="Default chain ID" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="18,0,8,0" />
                            <TextBox Text="{Binding DefaultChainId, UpdateSourceTrigger=PropertyChanged}" Width="190" />
                        </StackPanel>
                        <TextBlock Text="Resolvers are tried from left to right. Enter server IDs separated by commas; a failed resolver is temporarily removed after its threshold." Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                            <DataGridTextColumn Header="Resolver IDs in priority order" Binding="{Binding UpstreamIds, UpdateSourceTrigger=PropertyChanged}" Width="2.2*" />
                            <DataGridTextColumn Header="Failures" Binding="{Binding FailureThreshold, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Cooldown s" Binding="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Rules">
                <DockPanel Margin="0,18,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add rule" Command="{Binding AddRuleCommand}" />
                        <Button Content="Remove selected" Command="{Binding RemoveRuleCommand}" />
                        <TextBlock Text="Rules are evaluated from top to bottom." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" />
                            <DataGridTemplateColumn Header="Match" Width="100">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MatchKind}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox SelectedItem="{Binding MatchKind}" ItemsSource="{Binding DataContext.MatchKinds, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Action}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox SelectedItem="{Binding Action}" ItemsSource="{Binding DataContext.RuleActions, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Failover chain ID" Binding="{Binding ChainId, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Protection settings">
                <Border Margin="0,18,0,0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="24" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Windows enforcement" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="The signed WinDivert kernel driver captures outbound UDP DNS before a VPN or another local resolver can take it. Explicit TCP port 53 is blocked fail-closed while encrypted upstreams use ports 443 or 853." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,20" />
                        <CheckBox Content="Enable DNS enforcement" IsChecked="{Binding EnforcementEnabled}" Margin="0,0,0,12" />
                        <CheckBox Content="Block explicit TCP DNS leaks in the kernel network stack" IsChecked="{Binding BlockPlaintextDns}" Margin="0,0,0,18" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Enforcement check interval (seconds)" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding WatchdogSeconds}" Width="70" />
                        </StackPanel>
                        <TextBlock Text="BetterDNS does not inspect HTTPS: arbitrary application DoH on port 443 cannot be distinguished from normal web traffic without weakening TLS. The DNS packet interception path is kernel-level; encrypted resolver and policy logic remains isolated in the LocalSystem service." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,24,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Save configuration" Command="{Binding SaveCommand}" Background="#146B5C" BorderBrush="{StaticResource Accent}" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
