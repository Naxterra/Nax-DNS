<Window x:Class="BetterDns.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Icon="Assets/BetterDNS.ico"
        Height="900" Width="1260" MinHeight="680" MinWidth="980"
        Background="{StaticResource WindowBackground}"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBackground}" Margin="0">
      <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeroBackground}"
                BorderBrush="#35445E" BorderThickness="1" CornerRadius="15" Padding="20,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="58" Height="58" Source="Assets/BetterDNS.png" Stretch="Uniform" />

                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Better" FontSize="29" FontWeight="Bold" />
                        <TextBlock Text="DNS" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentTeal}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource App.Subtitle}" Style="{StaticResource MutedText}" FontSize="13.5" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,17,0">
                        <TextBlock Text="{DynamicResource App.Language}" Style="{StaticResource MutedText}" FontSize="11" Margin="1,0,0,3" />
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                  Width="125">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Border Background="#121A29" BorderBrush="#36455F" BorderThickness="1" CornerRadius="13" Padding="13,9">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#FF6F91" BlurRadius="9" ShadowDepth="0" Opacity="0.55" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentTeal}" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#43E6C3" BlurRadius="10" ShadowDepth="0" Opacity="0.65" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" IsEnabled="{Binding CanEdit}">
            <TabItem Header="{DynamicResource Tab.Dashboard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,12,0">
                        <Border Style="{StaticResource Card}" Background="{StaticResource HeroBackground}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="{Binding ProtectionText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding EnforcementText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LocalDnsStatusText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ToggleButtonText}" Command="{Binding ToggleProtectionCommand}"
                                        Style="{StaticResource PrimaryButton}" MinWidth="190" VerticalAlignment="Center" Margin="0" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource Setup.Heading}" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,4" />
                        <TextBlock Text="{DynamicResource Setup.Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentTeal}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Setup.Primary}" Foreground="{StaticResource AccentTeal}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Setup.PrimaryHint}" Style="{StaticResource MutedText}" Margin="0,5,0,12" />
                                    <ComboBox ItemsSource="{Binding Upstreams}" ItemTemplate="{StaticResource ProviderItemTemplate}" SelectedItem="{Binding PrimaryProvider}" MinHeight="38" FontWeight="Normal" />
                                    <TextBlock Text="{Binding PrimaryDetails}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="{StaticResource AccentPurple}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Setup.Backup}" Foreground="{StaticResource AccentPurple}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Setup.BackupHint}" Style="{StaticResource MutedText}" Margin="0,5,0,12" />
                                    <ComboBox ItemsSource="{Binding Upstreams}" ItemTemplate="{StaticResource ProviderItemTemplate}" SelectedItem="{Binding BackupProvider}" MinHeight="38" FontWeight="Normal" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource Setup.NoBackup}" Command="{Binding ClearBackupCommand}" Padding="7,3" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding BackupDetails}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Action.AddServer}" Command="{Binding AddUpstreamCommand}" Style="{StaticResource PurpleButton}" Margin="15,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding RouteSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouteSummary}" />
                                <TextBlock Text="{Binding ConfiguredRouteText}" Margin="0,5,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentTeal}" /><Style.Triggers><DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentOrange}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <Expander Header="{Binding ExtraFallbackSummary}" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,0">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Setup.ExtraHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ListBox ItemsSource="{Binding AdditionalFallbacks}" SelectedItem="{Binding SelectedExtraFallback}" DisplayMemberPath="DisplayName" MinHeight="75" MaxHeight="150" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <Button Content="{DynamicResource Action.Up}" Command="{Binding MoveExtraUpCommand}" Margin="0,0,0,5" />
                                            <Button Content="{DynamicResource Action.Down}" Command="{Binding MoveExtraDownCommand}" Margin="0,0,0,5" />
                                            <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveExtraFallbackCommand}" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource Setup.AddBackup}" Command="{Binding AddExtraFallbackCommand}" Margin="10,0,0,0" />
                                        <ComboBox ItemsSource="{Binding Upstreams}" ItemTemplate="{StaticResource ProviderItemTemplate}" SelectedItem="{Binding ExtraFallbackCandidate}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="{Binding RoutingStateText}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RoutingStateDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <TextBlock Text="{DynamicResource Setup.LiveTitle}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding LiveResolverText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,4" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding LastResponseUsedBackup}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentOrange}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding LiveRouteDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding RulesSummary}" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                        <TextBlock Text="{DynamicResource Setup.Scope}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Servers}">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="1.15*" MinHeight="210" /><RowDefinition Height="12" /><RowDefinition Height="*" MinHeight="185" /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Provider.LibraryTitle}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Provider.LibraryHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                            <WrapPanel>
                                <Button Content="{DynamicResource Action.AddServer}" Command="{Binding AddUpstreamCommand}" Style="{StaticResource PurpleButton}" />
                                <Button Content="{DynamicResource Action.Edit}" Command="{Binding EditUpstreamCommand}" />
                                <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveUpstreamCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Upstreams}" SelectedItem="{Binding SelectedUpstream}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Name}" Binding="{Binding DisplayName}" Width="1.4*" />
                                <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Protocol}" Binding="{Binding ProtocolDisplayName}" Width="95" />
                                <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Endpoint}" Binding="{Binding Endpoint}" Width="2*" />
                                <DataGridTemplateColumn Header="{DynamicResource Column.On}" Width="95">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  AutomationProperties.Name="{DynamicResource Provider.Enabled}" ToolTip="{DynamicResource Provider.ToggleHint}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#35445E" />
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Probe.TestAll}" Command="{Binding TestServersCommand}" Style="{StaticResource PurpleButton}" Margin="15,0,0,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Activity.StatusTitle}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Probe.Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UpstreamStatuses}" IsReadOnly="True" MinHeight="80">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Resolver}" Binding="{Binding Name}" Width="1.4*" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Protocol}" Binding="{Binding Protocol}" Width="75" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.LastResult}" Binding="{Binding StateText}" Width="1.2*" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Latency}" Binding="{Binding LatencyText}" Width="85" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Probe.CheckedAt}" Binding="{Binding CheckedText}" Width="105" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Probe.Source}" Binding="{Binding SourceText}" Width="115" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.LastError}" Binding="{Binding LastError}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Activity}">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Activity.QueryLogTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}" IsReadOnly="True" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Time}" Binding="{Binding TimeText}" Width="85" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Domain}" Binding="{Binding Domain}" Width="2*" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Resolver}" Binding="{Binding UpstreamName}" Width="1.5*" />
                            <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" Header="{DynamicResource Column.Result}" Binding="{Binding Result}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Activity.Attempts}" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="105" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding QueryDetails}" Style="{StaticResource MutedText}" TextWrapping="Wrap" /></ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Advanced}">
                <TabControl Margin="0,18,0,0">
            <TabItem Header="{DynamicResource Tab.Rules}">
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Action.AddRule}" Command="{Binding AddRuleCommand}" Style="{StaticResource PurpleButton}" />
                                <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveRuleCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Rules.Hint}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource Column.On}" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" EditingElementStyle="{StaticResource GridEditText}" Header="{DynamicResource Column.Name}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                                <DataGridTextColumn ElementStyle="{StaticResource GridDisplayText}" EditingElementStyle="{StaticResource GridEditText}" Header="{DynamicResource Column.Pattern}" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" />
                                <DataGridTemplateColumn Header="{DynamicResource Column.Match}" Width="185">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.MatchOptions, RelativeSource={RelativeSource AncestorType=Window}}" ItemTemplate="{StaticResource DisplayNamedItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding MatchKind, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Column.Action}" Width="170">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.ActionOptions, RelativeSource={RelativeSource AncestorType=Window}}" ItemTemplate="{StaticResource DisplayNamedItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Column.Chain}" Width="1.3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Chains, RelativeSource={RelativeSource AncestorType=Window}}" ItemTemplate="{StaticResource DisplayNamedItemTemplate}" SelectedValuePath="Id" SelectedValue="{Binding ChainId, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Failover}">
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Chain.Heading}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Chain.Explanation}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Action.AddChain}" Command="{Binding AddChainCommand}" Style="{StaticResource PurpleButton}" />
                                    <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveChainCommand}" />
                                    <TextBlock Text="{DynamicResource Failover.DefaultChain}" VerticalAlignment="Center" Margin="8,0,12,0" />
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding Chains}" ItemTemplate="{StaticResource DisplayNamedItemTemplate}" SelectedValuePath="Id" SelectedValue="{Binding DefaultChainId}" />
                            </DockPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain}" DisplayMemberPath="DisplayName" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Column.Name}" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding SelectedChain.EditableName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                    <TextBlock Text="{DynamicResource Chain.ServerOrder}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                                            <Button Content="{DynamicResource Action.Up}" Command="{Binding MoveChainServerUpCommand}" Margin="0,0,0,5" />
                                            <Button Content="{DynamicResource Action.Down}" Command="{Binding MoveChainServerDownCommand}" Margin="0,0,0,5" />
                                            <Button Content="{DynamicResource Action.RemoveSelected}" Command="{Binding RemoveChainServerCommand}" Margin="0" />
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding SelectedChainServers}" SelectedItem="{Binding SelectedChainServer}" DisplayMemberPath="DisplayName" MinHeight="130" MaxHeight="190" />
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,18">
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource Chain.AddServer}" Command="{Binding AddChainServerCommand}" Margin="10,0,0,0" />
                                        <ComboBox ItemsSource="{Binding Upstreams}" ItemTemplate="{StaticResource ProviderItemTemplate}" SelectedItem="{Binding ChainCandidate}" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource Chain.FailureThreshold}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedChain.FailoverMinutes, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{DynamicResource Chain.FailureHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource Chain.Cooldown}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedChain.CooldownSeconds, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" />
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{DynamicResource Chain.CooldownHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Protection}">
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PurpleGradient}" CornerRadius="11,0,0,11" />
                        <StackPanel Grid.Column="1" Margin="25">
                            <TextBlock Text="{DynamicResource Protection.Title}" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Protection.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,23" MaxWidth="930" HorizontalAlignment="Left" />
                            <CheckBox Content="{DynamicResource Protection.EnableEnforcement}" IsChecked="{Binding EnforcementEnabled}" Margin="0,0,0,14" />
                            <CheckBox Content="{DynamicResource Protection.BlockTcp}" IsChecked="{Binding BlockPlaintextDns}" Margin="0,0,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Protection.Interval}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,11,0" />
                                <TextBox Text="{Binding WatchdogSeconds}" Width="75" />
                            </StackPanel>
                            <Border Background="#121A2A" BorderBrush="#3A365F" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,25,0,0">
                                <TextBlock Text="{DynamicResource Protection.Limit}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="940" HorizontalAlignment="Left" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="{DynamicResource Service.Tab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Service.Title}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Service.Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,18" />
                            <TextBlock Text="{Binding WindowsServiceStatus}" FontSize="18" Foreground="{StaticResource AccentTeal}" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding LocalDnsStatusText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <WrapPanel>
                                <Button Content="{DynamicResource Service.Start}" Command="{Binding StartServiceCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="{DynamicResource Service.Stop}" Command="{Binding StopServiceCommand}" />
                                <Button Content="{DynamicResource Service.Install}" Command="{Binding InstallServiceCommand}" Style="{StaticResource PurpleButton}" />
                                <Button Content="{DynamicResource Service.Uninstall}" Command="{Binding UninstallServiceCommand}" />
                                <Button Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshServiceCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ServiceMessage}" TextWrapping="Wrap" Margin="0,18,0,0" ToolTip="{Binding ServiceErrorDetails}" />
                            <TextBlock Text="{DynamicResource Service.Preservation}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="2,16,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <Border Visibility="Collapsed" Width="4" Height="18" CornerRadius="2" Background="{StaticResource AccentCyan}" Margin="0,0,9,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding StatusDetails}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}" />
                <Button Content="{DynamicResource Action.Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0" />
            </StackPanel>
        </Grid>
      </Grid>
    </Grid>
</Window>
